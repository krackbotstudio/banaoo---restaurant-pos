# Copy to .env (or .env.local) and fill in values. Never commit real secrets.

# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:5001

# Server — database
DATABASE_URL=

# Server — session & auth (required for owner login)
SESSION_SECRET=change-me-to-a-long-random-string
SUPABASE_JWT_SECRET=

# Google OAuth — required for "Continue with Google"
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI (local): http://localhost:5001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
FRONTEND_URL=http://localhost:8080
