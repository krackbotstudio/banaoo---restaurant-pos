# Copy to .env (or .env.local) and fill in values. Never commit real secrets.

# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Must match the port the API listens on (default 5000). Required for Google session cookies.
VITE_API_URL=http://localhost:5000

# Server — database
DATABASE_URL=

# Local: development (Secure cookies break Google login on http://localhost).
# Production deploy: production
NODE_ENV=development

# Server — session & auth (required for owner login)
SESSION_SECRET=change-me-to-a-long-random-string
SUPABASE_JWT_SECRET=
# Optional: force Secure cookies on/off (overrides NODE_ENV heuristic)
# COOKIE_SECURE=false

# Google OAuth — required for "Continue with Google"
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI (local): http://localhost:5000/auth/google/callback
# Tip: server loads server/.env after this file, so you can keep secrets in server/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay — Banaoo subscription billing (Orders API)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Partner OAuth — restaurant "Connect Razorpay" in Settings → Payments
# Create an app: Razorpay Partner Dashboard → Applications → Development client
# Redirect URI (local): http://localhost:5001/api/razorpay/oauth/callback
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
# Optional: test | live (default test)
RAZORPAY_OAUTH_MODE=test


# Frontend origin for OAuth redirects (local Vite default port)
FRONTEND_URL=http://localhost:8080

# Public API base URL — required for Shiprocket webhooks during local dev (ngrok / cloudflared HTTPS URL).
# Example: API_PUBLIC_URL=https://abc123.ngrok-free.app
API_PUBLIC_URL=

# Shiprocket API Base URL (optional, defaults to https://apiv2.shiprocket.in. Set to https://sandbox.shiprocket.in or custom mock server for sandbox/testing)
SHIPROCKET_API_URL=https://apiv2.shiprocket.in




# Google Maps — server-side (Places / Directions if used by API)
GOOGLE_MAPS_API_KEY=

# Frontend Vite — must be prefixed with VITE_ to be available in the browser
# Restrict this key by HTTP referrer in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=

