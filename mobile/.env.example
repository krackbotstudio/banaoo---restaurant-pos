# Copy to .env in this folder (never commit .env).

# Production API + PWA (Play Store / release builds)
EXPO_PUBLIC_API_URL=https://banaoo.in
EXPO_PUBLIC_WEBAPP_URL=https://banaoo.in

# Supabase (same project as web app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# EAS CLI (CI or local): https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_TOKEN=
