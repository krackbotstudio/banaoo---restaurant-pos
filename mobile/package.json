{
  "name": "mobile",
  "version": "0.0.10",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:whoami": "eas whoami",
    "eas:login": "eas login",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:production": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "build:aab:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release-aab.ps1",
    "submit:play": "eas submit --platform android --profile production --latest",
    "android:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android-emulator.ps1",
    "icons:generate": "node ./scripts/build-adaptive-assets.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
